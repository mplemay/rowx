from typing import Any, Literal

from rowx.postgres._options import ConnectOptions
from rowx.postgres._vocab import AcceptedParam, CodecName, NullReasonName, PyResultName, TypeKey

class TypeInfo:
    @property
    def key(self) -> TypeKey: ...
    @property
    def matcher(self) -> Literal["oid", "enum", "named", "array", "domain"]: ...
    @property
    def matcher_oid(self) -> int | None: ...
    @property
    def matcher_name(self) -> str | None: ...
    @property
    def py_result(self) -> PyResultName: ...
    @property
    def tz(self) -> Literal["none", "aware", "naive"]: ...
    @property
    def accepted_params(self) -> list[AcceptedParam]: ...
    @property
    def decode(self) -> CodecName: ...
    @property
    def encode(self) -> CodecName: ...
    @property
    def encode_format(self) -> Literal["binary", "text"]: ...

def type_table() -> list[TypeInfo]: ...

class ParamInfo:
    @property
    def oid(self) -> int: ...
    @property
    def type_name(self) -> str: ...
    @property
    def type_key(self) -> TypeKey | None: ...
    @property
    def element_key(self) -> TypeKey | None: ...

class ColumnInfo:
    @property
    def name(self) -> str: ...
    @property
    def raw_name(self) -> str: ...
    @property
    def oid(self) -> int: ...
    @property
    def type_name(self) -> str: ...
    @property
    def type_key(self) -> TypeKey | None: ...
    @property
    def element_key(self) -> TypeKey | None: ...
    @property
    def table_oid(self) -> int | None: ...
    @property
    def attnum(self) -> int | None: ...
    @property
    def nullable(self) -> bool: ...
    @property
    def reason(self) -> NullReasonName: ...
    @property
    def reason_detail(self) -> str | None: ...

class Describe:
    @property
    def params(self) -> list[ParamInfo]: ...
    @property
    def columns(self) -> list[ColumnInfo]: ...

class RowStream:
    async def _next(self) -> list[object]: ...
    def close(self) -> None: ...
    @property
    def rows_affected(self) -> int | None: ...

class Connection:
    async def _fetch(
        self,
        sql: str,
        params: list[object],
        mask: list[bool] | None,
        scalar: bool,
        limit_one: bool,
        arity: int | None,
    ) -> list[object]: ...
    def _stream(
        self,
        sql: str,
        params: list[object],
        mask: list[bool] | None,
        scalar: bool,
        arity: int | None,
        batch_size: int,
    ) -> RowStream: ...
    async def _execute(self, sql: str, params: list[object]) -> int: ...
    async def ping(self) -> None: ...
    async def reset(self, query: str) -> None: ...
    async def close(self) -> None: ...
    def detach(self) -> None: ...
    async def _settle(self) -> None: ...
    async def _begin(self, isolation: str | None, readonly: bool, deferrable: bool) -> int: ...
    async def _savepoint(self) -> int: ...
    async def _release_savepoint(self, n: int) -> int: ...
    async def _rollback_to_savepoint(self, n: int) -> int: ...
    async def _end_transaction(self, commit: bool) -> None: ...
    def _clear_init_pending(self) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def init_pending(self) -> bool: ...
    @property
    def statement_cache_size(self) -> int: ...

class Pool:
    def __init__(
        self,
        options: ConnectOptions,
        /,
        *,
        min_size: int,
        max_size: int,
        acquire_timeout: float,
        idle_timeout: float | None,
        max_lifetime: float | None,
        max_queries: int | None,
        ping_after: float | None,
        reset_query: str | None,
    ) -> None: ...
    async def open(self) -> None: ...
    async def close(self, limit: float | None = None) -> None: ...
    def terminate(self) -> None: ...
    def expire_connections(self) -> None: ...
    async def acquire(self, limit: float | None = None) -> Connection: ...
    async def release(self, conn: Connection, reset_done: bool = False) -> None: ...
    def _release_nowait(self, conn: Connection) -> None: ...
    async def discard(self, conn: Connection) -> None: ...
    async def _fetch(
        self,
        sql: str,
        params: list[object],
        mask: list[bool] | None,
        scalar: bool,
        limit_one: bool,
        arity: int | None,
    ) -> list[object]: ...
    def _stream(
        self,
        sql: str,
        params: list[object],
        mask: list[bool] | None,
        scalar: bool,
        arity: int | None,
        batch_size: int,
    ) -> RowStream: ...
    async def _execute(self, sql: str, params: list[object]) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def idle(self) -> int: ...
    @property
    def waiting(self) -> int: ...
    @property
    def min_size(self) -> int: ...
    @property
    def max_size(self) -> int: ...
    @property
    def closed(self) -> bool: ...

def _cancel_requests_sent() -> int: ...
def _catalog_queries() -> int: ...
async def connect(options: ConnectOptions, /) -> Connection: ...
def parse_dsn(dsn: str, /) -> dict[str, Any]: ...
async def describe(conn: Connection, sql: str) -> Describe: ...
async def connect_checker(dsn: str, statement_timeout: float = 10.0) -> Connection: ...
