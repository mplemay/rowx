from typing import Literal, Self

def ping() -> str: ...

class TypeInfo:
    @property
    def key(self) -> str: ...
    @property
    def matcher(self) -> Literal["oid", "enum", "named", "array", "domain"]: ...
    @property
    def matcher_oid(self) -> int | None: ...
    @property
    def matcher_name(self) -> str | None: ...
    @property
    def py_result(self) -> str: ...
    @property
    def tz(self) -> Literal["none", "aware", "naive"]: ...
    @property
    def accepted_params(self) -> list[str]: ...
    @property
    def decode(self) -> str: ...
    @property
    def encode(self) -> str: ...
    @property
    def encode_format(self) -> Literal["binary", "text"]: ...

def type_table() -> list[TypeInfo]: ...

# planned bindings (design §7.2, §8.1): implemented by T07, T08 and T31-T33
class ParamInfo:
    @property
    def oid(self) -> int: ...
    @property
    def type_name(self) -> str: ...
    @property
    def type_key(self) -> str | None: ...

class ColumnInfo:
    @property
    def name(self) -> str: ...
    @property
    def raw_name(self) -> str: ...
    @property
    def oid(self) -> int: ...
    @property
    def type_name(self) -> str: ...
    @property
    def type_key(self) -> str | None: ...
    @property
    def table_oid(self) -> int | None: ...
    @property
    def attnum(self) -> int | None: ...
    @property
    def nullable(self) -> bool: ...
    @property
    def reason(self) -> str: ...

class Describe:
    @property
    def params(self) -> list[ParamInfo]: ...
    @property
    def columns(self) -> list[ColumnInfo]: ...

class Connection:
    async def _fetch(
        self,
        sql: str,
        params: list[object],
        mask: list[bool] | None,
        scalar: bool,
        limit_one: bool,
        arity: int | None,
    ) -> list[object]: ...
    async def _execute(self, sql: str, params: list[object]) -> int: ...
    async def close(self) -> None: ...
    async def __aenter__(self) -> Self: ...
    async def __aexit__(self, *exc: object) -> None: ...
    @property
    def closed(self) -> bool: ...

async def connect(
    dsn: str,
    /,
    *,
    connect_timeout: float | None = None,
    statement_cache_size: int = 256,
) -> Connection: ...
async def describe(conn: Connection, sql: str) -> Describe: ...
