from types import TracebackType
from typing import Final, Self

ENGINE_VERSION: Final[str]
RUNTIME_VERSION: Final[str]
WASM_SHA256: Final[str]
SNAPSHOT_FORMAT: Final[int]
EXTENSIONS: Final[tuple[str, ...]]

class EngineError(Exception): ...

class DirectoryInUseError(EngineError):
    pid: int | None
    directory: str

class SnapshotError(EngineError): ...

class Instance:
    @staticmethod
    def start(directory: str | None = None, snapshot: bytes | None = None) -> Instance: ...
    @property
    def dsn(self) -> str: ...
    @property
    def directory(self) -> str | None: ...
    @property
    def boot(self) -> str: ...
    @property
    def closed(self) -> bool: ...
    def snapshot(self) -> bytes: ...
    def close(self) -> None: ...
    def abandon(self, *, force: bool = False) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None = None,
        exc_value: BaseException | None = None,
        traceback: TracebackType | None = None,
    ) -> None: ...

def close_all() -> None: ...
