from collections.abc import Sequence
from pathlib import Path
from typing import Any, Literal

from rowx_sqlite._options import ConnectOptions, TransactionMode

type RowFormName = Literal["positional", "keyword", "dict", "validator"]
type ConstructName = Literal["cte", "subquery", "compound", "outer_join", "aggregate"]
type MatchingName = Literal["by_name", "positional"]
type IssueKind = Literal[
    "missing-column",
    "unexpected-column",
    "duplicate-column",
    "ambiguous-column",
    "column-name-mismatch",
    "arity-mismatch",
]
type TypeKey = Literal[
    "integer",
    "real",
    "text",
    "blob",
    "boolean",
    "datetime",
    "datetimetz",
    "date",
    "time",
    "decimal",
    "uuid",
    "json",
    "any",
]
type MigrationState = Literal["applied", "pending", "modified", "missing", "dirty"]
# (version, description, state, installed_on in microseconds since the epoch, execution_time in ns, checksum)
type StatusRow = tuple[int, str, MigrationState, int | None, int | None, bytes | None]
# (version, elapsed in ns); None for a dry run or a skip
type ResultRow = tuple[int, int | None]
type MigrationEntry = tuple[int, str, Literal["simple", "reversible"], Path, Path | None, bytes, bytes | None, bool]
type NullReasonName = Literal["NotNullColumn", "NullableColumn", "Unproven", "OverrideBang", "OverrideQuestion"]

def sqlite_version() -> str: ...

class TypeInfo:
    @property
    def key(self) -> TypeKey: ...
    @property
    def py_result(self) -> str: ...
    @property
    def tz(self) -> Literal["none", "aware", "naive"]: ...
    @property
    def accepted_params(self) -> list[str]: ...
    @property
    def codec(self) -> str: ...

def type_table() -> list[TypeInfo]: ...

class RowShape:
    def __init__(
        self,
        ctor: object,
        form: RowFormName,
        matching: MatchingName,
        type_name: str,
        fields: Sequence[tuple[str, Sequence[str] | None, bool, int]],
        /,
        *,
        validate: bool = True,
    ) -> None: ...
    @property
    def ctor(self) -> object: ...
    @property
    def form(self) -> RowFormName: ...
    @property
    def matching(self) -> MatchingName: ...
    @property
    def type_name(self) -> str: ...

class ShapeIssue:
    @property
    def kind(self) -> IssueKind: ...
    @property
    def columns(self) -> list[int]: ...
    @property
    def fields(self) -> list[int]: ...
    @property
    def name(self) -> str | None: ...
    @property
    def min(self) -> int | None: ...
    @property
    def max(self) -> int | None: ...
    @property
    def actual(self) -> int | None: ...

def map_columns(
    columns: Sequence[str],
    fields: Sequence[tuple[Sequence[str] | None, bool]],
    positional: bool,
) -> tuple[list[int | None], list[ShapeIssue]]: ...

class RowStream:
    async def _next(self) -> list[object]: ...
    def close(self) -> None: ...
    @property
    def rows_affected(self) -> int | None: ...

class Connection:
    async def _fetch(
        self,
        sql: str,
        params: list[object],
        mask: Sequence[int] | None,
        scalar: bool,
        limit_one: bool,
        arity: int | None,
        shape: RowShape | None,
    ) -> list[object]: ...
    def _stream(
        self,
        sql: str,
        params: list[object],
        mask: Sequence[int] | None,
        scalar: bool,
        arity: int | None,
        batch_size: int,
        shape: RowShape | None,
    ) -> RowStream: ...
    async def _execute(self, sql: str, params: list[object]) -> int: ...
    async def ping(self) -> None: ...
    async def close(self) -> None: ...
    def detach(self) -> None: ...
    async def _begin(self, mode: TransactionMode | None, read_only: bool) -> int: ...
    async def _savepoint(self) -> int: ...
    async def _release_savepoint(self, n: int) -> int: ...
    async def _rollback_to_savepoint(self, n: int) -> int: ...
    async def _end_transaction(self, commit: bool) -> None: ...
    async def _settle(self) -> None: ...
    async def reset(self) -> None: ...
    def _clear_init_pending(self) -> None: ...
    @property
    def init_pending(self) -> bool: ...
    @property
    def closed(self) -> bool: ...
    @property
    def statement_cache_size(self) -> int: ...
    @property
    def variable_limit(self) -> int: ...

class Pool:
    def __init__(
        self,
        options: ConnectOptions,
        /,
        *,
        min_size: int,
        max_size: int,
        acquire_timeout: float,
        idle_timeout: float | None,
        max_lifetime: float | None,
        max_queries: int | None,
        ping_after: float | None,
    ) -> None: ...
    async def open(self) -> None: ...
    async def close(self, limit: float | None = None) -> None: ...
    def terminate(self) -> None: ...
    def expire_connections(self) -> None: ...
    async def acquire(self, limit: float | None = None) -> Connection: ...
    async def release(self, conn: Connection, reset_done: bool = False) -> None: ...
    def _release_nowait(self, conn: Connection) -> None: ...
    async def discard(self, conn: Connection) -> None: ...
    async def _fetch(
        self,
        sql: str,
        params: list[object],
        mask: Sequence[int] | None,
        scalar: bool,
        limit_one: bool,
        arity: int | None,
        shape: RowShape | None,
    ) -> list[object]: ...
    def _stream(
        self,
        sql: str,
        params: list[object],
        mask: Sequence[int] | None,
        scalar: bool,
        arity: int | None,
        batch_size: int,
        shape: RowShape | None,
    ) -> RowStream: ...
    async def _execute(self, sql: str, params: list[object]) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def idle(self) -> int: ...
    @property
    def waiting(self) -> int: ...
    @property
    def min_size(self) -> int: ...
    @property
    def max_size(self) -> int: ...
    @property
    def closed(self) -> bool: ...

class Migrator:
    def __init__(
        self,
        path: Path,
        table: str,
        create_schemas: list[str],
        ignore_missing: bool,
        allow_out_of_order: bool,
        /,
    ) -> None: ...
    @property
    def migrations(self) -> list[MigrationEntry]: ...
    @property
    def table(self) -> tuple[str] | tuple[str, str]: ...
    async def run(
        self,
        executor: Connection | Pool,
        target: int | None = None,
        dry_run: bool = False,
    ) -> list[ResultRow]: ...
    async def revert(
        self,
        executor: Connection | Pool,
        target: int | None = None,
        revert_all: bool = False,
        dry_run: bool = False,
    ) -> list[ResultRow]: ...
    async def skip(
        self,
        executor: Connection | Pool,
        target: int | None = None,
        dry_run: bool = False,
    ) -> list[ResultRow]: ...
    async def info(self, executor: Connection | Pool) -> list[StatusRow]: ...

async def connect(options: ConnectOptions, /) -> Connection: ...
def parse_dsn(dsn: str, /) -> dict[str, Any]: ...

class ParamInfo:
    @property
    def name(self) -> str | None: ...
    @property
    def type_name(self) -> str: ...
    @property
    def type_key(self) -> None: ...
    @property
    def element_key(self) -> None: ...

class ColumnInfo:
    @property
    def name(self) -> str: ...
    @property
    def raw_name(self) -> str: ...
    @property
    def type_name(self) -> str: ...
    @property
    def type_key(self) -> TypeKey | None: ...
    @property
    def element_key(self) -> None: ...
    @property
    def nullable(self) -> bool: ...
    @property
    def reason(self) -> NullReasonName: ...
    @property
    def reason_detail(self) -> str | None: ...
    @property
    def database(self) -> str | None: ...
    @property
    def table(self) -> str | None: ...
    @property
    def column(self) -> str | None: ...

class Describe:
    @property
    def params(self) -> list[ParamInfo]: ...
    @property
    def columns(self) -> list[ColumnInfo]: ...

async def describe(
    conn: Connection,
    sql: str,
    sources: Sequence[Sequence[str]],
    *,
    constructs: Sequence[ConstructName],
) -> Describe: ...
async def connect_checker(dsn: str, statement_timeout: float = 10.0) -> Connection: ...
